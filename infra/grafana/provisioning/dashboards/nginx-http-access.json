        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "expr": "100 * (sum(increase(http_requests_total{job=\"nginx-log-exporter\",status=~\"2..\"}[$__range])) or vector(0)) / clamp_min((sum(increase(http_requests_total{job=\"nginx-log-exporter\"}[$__range])) or vector(0)), 1)",
          "instant": true,
          "legendFormat": "2** Status codes",
          "refId": "A"
        },
        {
          "expr": "100 * (sum(increase(http_requests_total{job=\"nginx-log-exporter\",status=~\"3..\"}[$__range])) or vector(0)) / clamp_min((sum(increase(http_requests_total{job=\"nginx-log-exporter\"}[$__range])) or vector(0)), 1)",
          "instant": true,
          "legendFormat": "3** Status codes",
          "refId": "B"
        },
        {
          "expr": "100 * (sum(increase(http_requests_total{job=\"nginx-log-exporter\",status=~\"4..\"}[$__range])) or vector(0)) / clamp_min((sum(increase(http_requests_total{job=\"nginx-log-exporter\"}[$__range])) or vector(0)), 1)",
