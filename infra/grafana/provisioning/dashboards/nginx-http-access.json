        {
          "expr": "100 * (sum(increase(http_requests_total{job=\"nginx-log-exporter\",status=\"403\"}[$__range])) or vector(0)) / clamp_min((sum(increase(http_requests_total{job=\"nginx-log-exporter\"}[$__range])) or vector(0)), 1)",
