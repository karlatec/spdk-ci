        {
          "expr": "100 * (sum(increase(http_requests_total{job=\"nginx-log-exporter\",status=\"404\"}[$__range])) or vector(0)) / clamp_min((sum(increase(http_requests_total{job=\"nginx-log-exporter\"}[$__range])) or vector(0)), 1)",
          "instant": true,
          "legendFormat": "404 Status codes",
          "refId": "E"
        },
        {
          "expr": "100 * (sum(increase(http_requests_total{job=\"nginx-log-exporter\",status=~\"5..\"}[$__range])) or vector(0)) / clamp_min((sum(increase(http_requests_total{job=\"nginx-log-exporter\"}[$__range])) or vector(0)), 1)",
          "instant": true,
          "legendFormat": "5** Status codes",
          "refId": "F"
        }
      ],
