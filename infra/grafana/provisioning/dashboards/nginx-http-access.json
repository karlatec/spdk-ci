  "panels": [
    {
      "datasource": null,
      "description": "Each value is the percentage of all requests in the selected time range. The 403 and 404 rows are subsets of the 4xx row.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2** Status codes"
            },
            "properties": [
              {
                "id": "color",
