loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Live Nginx JSON event log.
loki.process "nginx_json" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      timestamp      = "timestamp",
      remote_addr    = "remote_addr",
      method         = "method",
      uri            = "uri",
      status         = "status",
      response_bytes = "response_bytes",
      request_time   = "request_time",
      user_agent     = "user_agent",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }

  stage.geoip {
    db      = "/etc/alloy/geoip/GeoLite2-City.mmdb"
    source  = "remote_addr"
    db_type = "city"
  }

  stage.geoip {
    db      = "/etc/alloy/geoip/GeoLite2-ASN.mmdb"
    source  = "remote_addr"
    db_type = "asn"
  }

  // Keep extracted fields in the log body, not as indexed Loki labels.
  stage.pack {
    labels = [
      "timestamp",
      "remote_addr",
      "method",
      "uri",
      "status",
      "response_bytes",
      "request_time",
      "user_agent",
      "geoip_location_latitude",
      "geoip_location_longitude",
      "geoip_country_code",
      "geoip_city_name",
      "geoip_autonomous_system_number",
      "geoip_autonomous_system_organization",
    ]
    ingest_timestamp = false
  }
}

loki.source.file "nginx_json" {
  targets = [
    {
      __path__ = "/var/log/nginx/events.json",
      job      = "nginx",
      source   = "live",
    },
  ]
  forward_to = [loki.process.nginx_json.receiver]
}

loki.source.file "nginx_geo_json" {
  targets = [
    {
      __path__ = "/var/log/nginx/geo.json",
      job      = "nginx",
      source   = "live",
    },
  ]
  forward_to = [loki.process.nginx_json.receiver]
}
